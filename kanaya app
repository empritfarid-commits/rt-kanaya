     return kasData.reduce((acc, curr) => {
       return curr.jenis === 'pemasukan' ? acc + parseFloat(curr.nominal) : acc - parseFloat(curr.nominal);
     }, 0);
   }, [kasData]);
 
   const handleSubmit = async (e) => {
     e.preventDefault();
